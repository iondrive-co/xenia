#!/usr/bin/env python3

import sys

if sys.version_info < (3, 11):
    sys.stderr.write(
        "xenia needs Python 3.11 or newer; this is %d.%d.\n"
        "macOS ships an older one — try `python3.11 %s` or install a newer "
        "Python.\n" % (sys.version_info[0], sys.version_info[1], sys.argv[0]))
    raise SystemExit(1)

import os

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src"))

from xenia.mcp import main

sys.exit(main())
